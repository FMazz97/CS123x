{
  "name": "cs123x",
  "version": "2.0.4",
  "description": "Arduino and ESP-IDF library for Chipsea CS1237 and CS1238 24-bit differential ADCs. Designed for weight scales, load cells, and bridge sensors with full PGA control, flexible sampling rates, two-point scale calibration, internal temperature monitoring, and internal short-circuit offset diagnostics.",
  "keywords": [
    "cs1237",
    "cs1238",
    "cs123",
    "chipsea",
    "adc",
    "load-cell",
    "scale",
    "weight",
    "weighing",
    "sensor"
  ],
  "homepage": "https://github.com/FMazz97/CS123x",
  "repository": {
    "type": "git",
    "url": "https://github.com/FMazz97/CS123x.git"
  },
  "authors": [
    {
      "name": "FMazz97",
      "url": "https://github.com/FMazz97",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": "*",
  "examples": [
    {
